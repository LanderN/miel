<resources>
    <color name="miel_cream">#F5EFE4</color>

    <style name="MielTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:alertDialogTheme">@style/MielDialog</item>
        <item name="android:colorAccent">#A36A16</item>
        <item name="android:colorControlActivated">#A8731C</item>
        <item name="android:navigationBarColor">@color/miel_cream</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <style name="MielDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/miel_dialog</item>
        <item name="android:colorBackground">@color/miel_cream</item>
        <item name="android:textColorPrimary">#4B3928</item>
        <item name="android:textColorSecondary">#6C5B46</item>
        <item name="android:fontFamily">@font/nunito_regular</item>
        <item name="android:colorAccent">#A36A16</item>
        <item name="android:windowElevation">8dp</item>
    </style>
</resources>
