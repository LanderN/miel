+const void* PackDS1555(const void* data, size_t count)
+{
+    static std::vector<u16> packed;
+    packed.resize(count);
+    const u16* in = (const u16*)data;
+    for (size_t i = 0; i < count; i++)
+    {
+        u16 v = in[i];
+        packed[i] = ((v & 0x1F) << 11) | (((v >> 5) & 0x1F) << 6) | (((v >> 10) & 0x1F) << 1) | (v >> 15);
+    }
+    return packed.data();
+}
+
+void ReadPixelsDS1555(GLint x, GLint y, GLsizei w, GLsizei h, void* out)
+{
+    static std::vector<u8> rgba;
+    rgba.resize(size_t(w) * h * 4);
+    glReadPixels(x, y, w, h, GL_RGBA, GL_UNSIGNED_BYTE, rgba.data());
+    u16* dst = (u16*)out;
+    for (size_t i = 0; i < size_t(w) * h; i++)
+    {
+        const u8* p = &rgba[i * 4];
+        dst[i] = (p[0] >> 3) | ((p[1] >> 3) << 5) | ((p[2] >> 3) << 10) | ((p[3] >> 7) << 15);
+    }
+}
+#endif
