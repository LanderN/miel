+// DS colours keep red in the low bits and alpha on top. OpenGL ES cannot upload or read that
+// layout, so it is repacked as GL_UNSIGNED_SHORT_5_5_5_1.
+#ifdef HAVE_OPENGLES
+#define GL_DS_1555 GL_UNSIGNED_SHORT_5_5_5_1
+const void* PackDS1555(const void* data, size_t count);
