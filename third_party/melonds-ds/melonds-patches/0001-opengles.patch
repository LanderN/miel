+#else
+#define GL_DS_1555 GL_UNSIGNED_SHORT_1_5_5_5_REV
+inline const void* PackDS1555(const void* data, size_t) { return data; }
+inline void ReadPixelsDS1555(GLint x, GLint y, GLsizei w, GLsizei h, void* out)
+{
+    glReadPixels(x, y, w, h, GL_RGBA, GL_UNSIGNED_SHORT_1_5_5_5_REV, out);
+}
+#endif
+
 }
 
